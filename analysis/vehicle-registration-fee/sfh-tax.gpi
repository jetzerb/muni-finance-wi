minCol = colSFH; # Inflation Adjusted SFH Property Tax


# Set labels and titles
set xlabel  "Year";
set ylabel  "SFH Tax in 2024 Dollars"       textcolor rgb colorSFH;
set y2label "Median Income in 2024 Dollars" textcolor rgb colorIncome;
set title   "SFH Tax Buying Power";

# Enable secondary y-axis
set y2tics;
set ytics nomirror;
set key inside top left;


# Plot the data
plot taxfile using 1:colSFH               title "SFH Tax"           with linespoints linestyle lsSFH, \
     ""      using 1:colSFH:(column(colYear) == 2011 ? "Library"       : "") with labels offset -3,1   notitle, \
     ""      using 1:colSFH:(column(colYear) == 2018 ? "Fire Stations" : "") with labels offset  1,0.6 notitle, \
     taxfile using 1:colIncome axes x1y2  title "Median Income"     with linespoints linestyle lsIncome, \
     min_since_library                    title "Min Since Library" with lines       linestyle lsMin;
