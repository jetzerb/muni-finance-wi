minCol = colInflAdjCityPerCapita;


# Set labels and titles
set xlabel  "Year";
set ylabel  "Budget Per Capita in 2024 Dollars" textcolor rgb colorPerCap;
set y2label "Median Income in 2024 Dollars"     textcolor rgb colorIncome;
set title   "Per Capita Buying Power";

# Enable secondary y-axis
set y2tics;
set ytics nomirror;
set key inside top left;


# Plot the data
plot taxfile using 1:colInflAdjCityPerCapita             title "Budget Per Capita"       with linespoints linestyle lsPerCap, \
     ""      using 1:colInflAdjCityPerCapita:(column(colYear) == 2011 ? "Library"       : "") with labels offset -3,1 notitle, \
     ""      using 1:colInflAdjCityPerCapita:(column(colYear) == 2018 ? "Fire Stations" : "") with labels offset  1,1 notitle, \
     ""      using 1:colInflAdjNatlMedianWage  axes x1y2 title "National Median Income"  with linespoints linestyle lsIncome, \
     ""      using 1:colInflAdjLocalMedianWage axes x1y2 title "Fitchburg Median Income" with linespoints linestyle lsIncome, \
     min_since_library                                   title "Min Since Library"       with lines       linestyle lsMin;
