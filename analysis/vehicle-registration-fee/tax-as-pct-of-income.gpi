minCol = colSFH; # dummy value; not displaying minimum here


# Set labels and titles
set xlabel  "Year";
set ylabel  "SFH Tax as % of Median Income"           textcolor rgb colorSFH;
set y2label "Per Capita Budget as % of Median Income" textcolor rgb colorPerCap;
set title   "Property Tax as Percent of Median Income";

# Enable secondary y-axis
set y2tics;
set ytics nomirror;

set key off;


# Plot the data
plot taxfile using 1:colSFH2Inc              title "SFH Percentage"        with linespoints linestyle lsSFH, \
     ""      using 1:colSFH2Inc:(column(colYear) == 2011 ? "Library"       : "") with labels offset -3, 1 notitle, \
     ""      using 1:colSFH2Inc:(column(colYear) == 2018 ? "Fire Stations" : "") with labels offset -1.5,-4 rotate by 90 notitle, \
     taxfile using 1:colPerCap2Inc axes x1y2 title "Per Capita Percentage" with linespoints linestyle lsPerCap;
