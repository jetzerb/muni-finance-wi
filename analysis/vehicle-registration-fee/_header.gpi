# Set terminal and output file
set terminal pdfcairo size 11, 8.5 font "Arial,32" linewidth 5;
set key font ",24";
set pointsize 1.5;
set output "FILENAME.pdf"

# define my colors
# Note: these should be OK for color blind people (Okabe and Ito)
colorSFH         = "#56b4e9"; # light blue
colorPointSFH    = "#0072b2"; # dark blue
colorIncome      = "#cc79a7"; # pink/purple
colorPerCap      = "#e69f00"; # orange
colorPointPerCap = "#d55e00"; # dark orange
colorCity        = "#000000"; # black
colorMin         = "#009e73"; # green

# define line style indices
i = 1;
lsSFH         = i; i = i + 1;
lsPerCap      = i; i = i + 1;
lsIncome      = i; i = i + 1;
lsPointSFH    = i; i = i + 1;
lsPointPerCap = i; i = i + 1;
lsMin         = i; i = i + 1;
lsCity        = i; i = i + 1;

# define data columns
i = 1;
colYear                       = i; i = i + 1;
colDecCPI                     = i; i = i + 1;
colInflAdjNatlMedianWage      = i; i = i + 1;
colInflAdjLocalMedianWage     = i; i = i + 1;
colPopulation                 = i; i = i + 1;
colAssessedValue              = i; i = i + 1;
colEqualizedValue             = i; i = i + 1;
colMedianSFAssessed           = i; i = i + 1;
colMedianSFTax                = i; i = i + 1;
colInflAdjMedSFTax            = i; i = i + 1;
colMedianMFAssessed           = i; i = i + 1;
colMedianMFTax                = i; i = i + 1;
colInflAdjMedMFTax            = i; i = i + 1;
colLevyCityTotal              = i; i = i + 1;
colLevyOverlyingTotal         = i; i = i + 1;
colLevyGrandTotal             = i; i = i + 1;
colLevyCityPct                = i; i = i + 1;
colLevyCityPctVRF             = i; i = i + 1;
colInflAdjCityPerCapita       = i; i = i + 1;
colInflAdjCityPerCapitaVRF    = i; i = i + 1;
colSFTaxToNatlMedianWage      = i; i = i + 1;
colSFTaxToNatlMedianWageVRF   = i; i = i + 1;
colSFTaxToLocalMedianWage     = i; i = i + 1;
colSFTaxToLocalMedianWageVRF  = i; i = i + 1;
colPerCapToNatlMedianWage     = i; i = i + 1;
colPerCapToNatlMedianWageVRF  = i; i = i + 1;
colPerCapToLocalMedianWage    = i; i = i + 1;
colPerCapToLocalMedianWageVRF = i; i = i + 1;

MINCOL

# Read data from file
set datafile separator "\t";
dataFile = "FILENAME.txt";

# Calculate stats on the column we're tracking
stats dataFile using (column(colYear) > 2010 && column(minCol) > 0 ? column(minCol) : 1/0) nooutput;
min_since_library = STATS_min;
max_since_library = STATS_max;

# Define styles for the series
set style line lsSFH         linecolor rgb colorSFH         pointtype  7 linetype 1;  # Circles with lines
set style line lsPointSFH    linecolor rgb colorPointSFH    pointtype 13           ;  # Diamonds
set style line lsPerCap      linecolor rgb colorPerCap      pointtype  5 linetype 1;  # Squares with lines
set style line lsPointPerCap linecolor rgb colorPointPerCap pointtype 13           ;  # Diamonds
set style line lsIncome      linecolor rgb colorIncome      pointtype  9 linetype 1;  # Upward triangles with lines
set style line lsMin         linecolor rgb colorMin                      linetype 1;  # Lines only
set style line lsCity        linecolor rgb colorCity        pointtype 15 linetype 1;  # Pentagons with lines

set grid;
#--------------------------------------------------------------------------------
