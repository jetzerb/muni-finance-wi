minCol = colInflAdjCityPerCapita;
2003  # minimum year I care about


# Set labels and titles
set xlabel  "Year";
set ylabel  "Budget Per Capita in 2024 Dollars"                 textcolor rgb colorPerCap;
set y2label "Fitchburg Median Household Income in 2024 Dollars" textcolor rgb colorIncome;
set title   "Per Capita Buying Power";

# Enable secondary y-axis
set y2tics;
set ytics nomirror;
set grid;

set key inside top left;


# Plot the data
plot dataFile using colYear:colInflAdjCityPerCapita              title "Budget Per Capita"            with linespoints linestyle lsPerCap, \
     ""       using colYear:colInflAdjCityPerCapita :(column(colYear) == 2011 ? "Library"       : "") with labels offset  -3, 1 notitle, \
     ""       using colYear:colInflAdjCityPerCapita :(column(colYear) == 2018 ? "Fire Stations" : "") with labels offset -.5,-3.5 rotate by 90 notitle, \
     ""       using colYear:(column(colYear) == 2023 ? column(colInflAdjCityPerCapitaVRF) : 1/0) \
                                                                 title "VRF Effect"  with points linestyle lsPointPerCap, \
     ""       using colYear:colInflAdjLocalMedianWage  axes x1y2 title "FItchburg Median Income"      with linespoints linestyle lsIncome, \
     min_since_library                                           title "Min Since Library"            with lines       linestyle lsMin;
