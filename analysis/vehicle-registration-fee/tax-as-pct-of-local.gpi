minCol = colInflAdjMedSFTax; # dummy value; not displaying minimum here
2003  # minimum year I care about


# Set labels and titles
set xlabel  "Year";
set ylabel  "SFH Tax as % of Fitchburg Median Household Income"           textcolor rgb colorSFH;
set y2label "Per Capita Budget as % of Fitchburg Median Household Income" textcolor rgb colorPerCap;
set title   "Property Tax as % of Fitchburg Median Household Income";

# Enable secondary y-axis
set y2tics;
set ytics nomirror;
set grid;

set key off;

set xrange[2012:]; # only data from 2014 onward, but give graph some padding

# Plot the data
plot dataFile using colYear:colSFTaxToLocalMedianWage              title "SFH Percentage"              with linespoints linestyle lsSFH, \
     ""       using colYear:(column(colYear) == 2023 ? column(colSFTaxToLocalMedianWageVRF) : 1/0) \
                                                                   title "SFH 2 Car VRF Effect"        with points      linestyle lsPointSFH, \
     ""       using colYear:colPerCapToLocalMedianWage axes x1y2   title "Per Capita Percentage"       with linespoints linestyle lsPerCap, \
     ""       using colYear:(column(colYear) == 2023 ? column(colPerCapToLocalMedianWageVRF) : 1/0) axes x1y2 \
                                                                  title "Per Capita VRF Effect"       with points      linestyle lsPointPerCap;
